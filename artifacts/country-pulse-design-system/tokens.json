{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f3ee" },
      "foreground": { "$value": "#10232b" },
      "border": { "$value": "#d4ddd8" },
      "card": { "$value": "#fffdf8" },
      "cardForeground": { "$value": "#10232b" },
      "popover": { "$value": "#fffdf8" },
      "popoverForeground": { "$value": "#10232b" },
      "primary": {
        "$value": "#ef6b4a",
        "$description": "Country Pulse coral. Use for primary actions and editorial emphasis."
      },
      "primaryForeground": { "$value": "#10232b" },
      "secondary": { "$value": "#ddeae6" },
      "secondaryForeground": { "$value": "#10232b" },
      "muted": { "$value": "#ece8e0" },
      "mutedForeground": {
        "$value": "#53635f",
        "$description": "Darkened slightly from the source's subdued gray-green for readable small labels."
      },
      "accent": {
        "$value": "#d6e870",
        "$description": "Country Pulse lime. Reserve for selected and live states."
      },
      "accentForeground": { "$value": "#10232b" },
      "destructive": { "$value": "#b3453c" },
      "destructiveForeground": { "$value": "#fffdf8" },
      "input": { "$value": "#d4ddd8" },
      "ring": { "$value": "#ef6b4a" },
      "chart1": { "$value": "#ef6b4a" },
      "chart2": { "$value": "#5d927f" },
      "chart3": { "$value": "#2c6971" },
      "chart4": { "$value": "#c4a540" },
      "chart5": { "$value": "#bb6257" },
      "sidebar": { "$value": "#10232b" },
      "sidebarForeground": { "$value": "#f5f3ee" },
      "sidebarBorder": { "$value": "#2d4748" },
      "sidebarPrimary": { "$value": "#ef6b4a" },
      "sidebarPrimaryForeground": { "$value": "#10232b" },
      "sidebarAccent": { "$value": "#203a3d" },
      "sidebarAccentForeground": { "$value": "#f5f3ee" },
      "sidebarRing": { "$value": "#d6e870" }
    },
    "dark": {
      "background": { "$value": "#0d1c21" },
      "foreground": { "$value": "#f5f3ee" },
      "border": { "$value": "#2d4748" },
      "card": { "$value": "#13282f" },
      "cardForeground": { "$value": "#f5f3ee" },
      "popover": { "$value": "#13282f" },
      "popoverForeground": { "$value": "#f5f3ee" },
      "primary": {
        "$value": "#ff8a68",
        "$description": "Dark-mode Country Pulse coral for actions and editorial emphasis."
      },
      "primaryForeground": { "$value": "#10232b" },
      "secondary": { "$value": "#203a3d" },
      "secondaryForeground": { "$value": "#f5f3ee" },
      "muted": { "$value": "#1a3237" },
      "mutedForeground": { "$value": "#b6c8c2" },
      "accent": { "$value": "#d6e870" },
      "accentForeground": { "$value": "#10232b" },
      "destructive": { "$value": "#e27468" },
      "destructiveForeground": { "$value": "#10232b" },
      "input": { "$value": "#2d4748" },
      "ring": { "$value": "#ff8a68" },
      "chart1": { "$value": "#ff8a68" },
      "chart2": { "$value": "#8cc6af" },
      "chart3": { "$value": "#79b8c2" },
      "chart4": { "$value": "#d6e870" },
      "chart5": { "$value": "#f4a28f" },
      "sidebar": { "$value": "#071418" },
      "sidebarForeground": { "$value": "#f5f3ee" },
      "sidebarBorder": { "$value": "#2d4748" },
      "sidebarPrimary": { "$value": "#d6e870" },
      "sidebarPrimaryForeground": { "$value": "#10232b" },
      "sidebarAccent": { "$value": "#203a3d" },
      "sidebarAccentForeground": { "$value": "#f5f3ee" },
      "sidebarRing": { "$value": "#ff8a68" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1.25rem",
      "$description": "The source theme uses 20px as its base radius; controls and cards use nearby steps."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
